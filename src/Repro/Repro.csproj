<Project Sdk="MSTest.Sdk/4.5.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Keep analyzer warnings out of the annotations so only the report-gh extension output is visible. -->
    <NoWarn>$(NoWarn);MSTEST0025</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.GitHubActionsReport" Version="2.5.1" />
  </ItemGroup>

</Project>
